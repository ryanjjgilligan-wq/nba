# Optional — when set, Game 3 Oracle pulls live data. Without these, it serves bundled fixtures
# seeded with the real Game 3 baseline. The UI labels each datum LIVE or FIXTURE.

# Betting odds (https://the-odds-api.com)
ODDS_API_KEY=

# NBA stats provider (https://www.balldontlie.io — free tier supports most endpoints)
BALLDONTLIE_API_KEY=

# Optional alternate stats provider
SPORTSDATA_API_KEY=

# X / Twitter API v2 bearer token for sentiment feed (optional)
X_BEARER_TOKEN=
